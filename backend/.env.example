# Backend environment template. Copy to .env and fill locally; never commit .env.
APP_ENV=development
API_PREFIX=/api/v1

# SQLite file. Relative paths are resolved from the process working directory.
DATABASE_PATH=data/seenjeem.db
SQLITE_BUSY_TIMEOUT_MS=5000

# Comma-separated exact origins for the Vite dev server or LAN host.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# A wildcard origin must be enabled here explicitly, and never with credentials.
# Only for a local-LAN demo without cookies/auth headers.
ALLOW_LAN_WILDCARD_ORIGIN=false
ALLOW_CREDENTIALS=false

# Admin routes stay disabled unless this is set. Send it as X-Admin-Token.
# Generate a long random value locally; do not commit it.
ADMIN_TOKEN=

# Deterministic seed inputs.
SEED_VERSION=2026.10.1
SEED_RANDOM_SEED=20261019
MAX_TEAM_NAME_LENGTH=40

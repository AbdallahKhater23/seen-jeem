# Copy to .env before running: docker compose up --build
# Generate ADMIN_TOKEN with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Published frontend port. The backend is only reachable through Nginx.
APP_PORT=8080

# Same-origin through Nginx, so no CORS configuration is required.

# Deterministic seed inputs used only when the database volume is empty.
SEED_VERSION=2026.10.1
SEED_RANDOM_SEED=20261019
SQLITE_BUSY_TIMEOUT_MS=5000
